{
  "name": "@luminatick/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 8787 --config wrangler.local.json",
    "deploy": "wrangler deploy",
    "migration:create": "wrangler d1 migrations create tocyn-local --config wrangler.local.json",
    "migration:apply": "wrangler d1 migrations apply tocyn-local --local --config wrangler.local.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest",
    "test:local-auth": "node scripts/local-auth-smoke.mjs",
    "test:local-tenants": "tsx scripts/verify-local-tenant-fixture.ts",
    "test:local-tenants:focused": "tsx --test scripts/local-tenant-fixture.test.ts",
    "fixture:local-tenants": "tsx scripts/run-local-tenant-fixture.ts --interactive-credentials",
    "typecheck:local-tenants": "tsc -p scripts/tsconfig.local-tenant-fixture.json",
    "test:tenant-isolation-core": "tsx --test scripts/tenant-isolation-core.test.ts scripts/article-body-format-runtime.test.ts",
    "typecheck:tenant-isolation-core": "tsc -p scripts/tsconfig.tenant-isolation-core.json",
    "test:tenant-isolation-storage-background": "tsx --test scripts/tenant-isolation-storage-background.test.ts scripts/durable-object-resource-runtime.test.ts scripts/notification-capacity-runtime.test.ts scripts/notification-collaboration-runtime.test.ts scripts/notification-typing-resource-runtime.test.ts scripts/realtime-admission-runtime.test.ts scripts/vectorize-workflow-runtime.test.ts scripts/knowledge-index-manifest-runtime.test.ts",
    "test:budget-coordinator-runtime": "tsx --test scripts/budget-coordinator-do-runtime.test.ts",
    "test:budget-authority-runtime": "tsx --test scripts/budget-authority-runtime.test.ts",
    "test:budget-grant-holder-runtime": "tsx --test scripts/budget-grant-holder-runtime.test.ts",
    "typecheck:tenant-isolation-storage-background": "tsc -p scripts/tsconfig.tenant-isolation-storage-background.json",
    "test:local-tenant-realtime": "node --import tsx scripts/local-tenant-realtime-smoke.mjs",
    "test:canonical-conversation": "tsx --test scripts/canonical-conversation.test.ts",
    "typecheck:canonical-conversation": "tsc -p scripts/tsconfig.canonical-conversation.json",
    "test:canonical-conversation-atomic": "tsx --test scripts/canonical-conversation-atomic.test.ts",
    "typecheck:canonical-conversation-atomic": "tsc -p scripts/tsconfig.canonical-conversation-atomic.json",
    "test:ticket-mutation-replay": "tsx --test scripts/ticket-mutation-replay.test.ts",
    "typecheck:ticket-mutation-replay": "tsc -p scripts/tsconfig.ticket-mutation-replay.json",
    "test:conversation-audit": "tsx --test scripts/conversation-audit.test.ts",
    "typecheck:conversation-audit": "tsc -p scripts/tsconfig.conversation-audit.json",
    "fixture:local-beta": "tsx scripts/run-local-tenant-fixture.ts --interactive-credentials --local-beta",
    "beta:operator": "tsx scripts/run-local-beta-operator.ts",
    "test:local-beta": "tsx --test scripts/local-beta-guardrails.test.ts scripts/local-beta-atomic.test.ts",
    "typecheck:local-beta": "tsc -p scripts/tsconfig.local-beta-guardrails.json",
    "test:local-beta-runtime": "tsx --test scripts/local-beta-runtime.test.ts && tsx --test scripts/local-beta-launch.test.ts",
    "test:local-portal-workflow": "tsx --test scripts/local-portal-workflow.test.ts",
    "typecheck:local-portal-workflow": "tsc -p scripts/tsconfig.local-portal-workflow.json",
    "test:operator-workflow": "tsx --test scripts/operator-workflow.test.ts scripts/operator-draft-retention.test.ts",
    "typecheck:operator-workflow": "tsc -p scripts/tsconfig.operator-workflow.json",
    "test:operator-activity": "tsx --test scripts/operator-activity.test.ts",
    "typecheck:operator-activity": "tsc -p scripts/tsconfig.operator-activity.json",
    "test:operational-performance": "tsx --test scripts/operational-performance.test.ts",
    "test:operational-metrics": "tsx --test scripts/operational-metrics.test.ts",
    "test:observability-config": "node --test scripts/observability-config.test.mjs",
    "test:local-observability-collector": "tsx --test scripts/local-observability-collector.test.ts",
    "typecheck:local-observability-collector": "tsc -p scripts/tsconfig.local-observability-collector.json",
    "typecheck:operational-performance": "tsc -p scripts/tsconfig.operational-performance.json",
    "evidence:operational-performance": "tsx scripts/run-operational-performance.ts",
    "test:staff-ticket-mutation-runtime": "tsx --test scripts/staff-ticket-mutation-runtime.test.ts",
    "typecheck:staff-ticket-mutation-runtime": "tsc -p scripts/tsconfig.staff-ticket-mutation-runtime.json",
    "test:combined-collision-runtime": "tsx --test scripts/combined-collision-runtime.test.ts",
    "typecheck:combined-collision-runtime": "tsc -p scripts/tsconfig.combined-collision-runtime.json",
    "test:ui-combined-collision-browser": "tsx --test scripts/ui-combined-collision-browser.test.ts",
    "typecheck:ui-combined-collision-browser": "tsc -p scripts/tsconfig.ui-combined-collision-browser.json",
    "test:budget-admission-runtime": "tsx --test scripts/budget-admission-runtime.test.ts scripts/session-budget-admission-runtime.test.ts scripts/customer-budget-admission-runtime.test.ts scripts/storage-admission-runtime.test.ts scripts/api-ticket-history-admission-runtime.test.ts scripts/api-ticket-detail-admission-runtime.test.ts scripts/http-ai-admission-runtime.test.ts scripts/http-ticket-read-admission-runtime.test.ts scripts/support-sla-admission-runtime.test.ts scripts/support-sla-mutation-receipts.test.ts"
  },
  "dependencies": {
    "@luminatick/shared": "*",
    "hono": "^4.13.7",
    "jose": "^6.2.2",
    "otpauth": "^9.5.0",
    "postal-mime": "^2.1.0",
    "re2js": "^2.8.6",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240101.0",
    "@faker-js/faker": "^10.4.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.5",
    "better-sqlite3": "^12.9.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.2",
    "vitest": "^4.1.11"
  }
}
