{
  "name": "@luminatick/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 8787 --config wrangler.local.json",
    "deploy": "wrangler deploy",
    "migration:create": "wrangler d1 migrations create tocyn-local --config wrangler.local.json",
    "migration:apply": "wrangler d1 migrations apply tocyn-local --local --config wrangler.local.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest",
    "test:local-auth": "node scripts/local-auth-smoke.mjs",
    "test:local-tenants": "tsx scripts/verify-local-tenant-fixture.ts",
    "test:local-tenants:focused": "tsx --test scripts/local-tenant-fixture.test.ts",
    "fixture:local-tenants": "tsx scripts/run-local-tenant-fixture.ts --interactive-credentials",
    "typecheck:local-tenants": "tsc -p scripts/tsconfig.local-tenant-fixture.json",
    "test:tenant-isolation-core": "tsx --test scripts/tenant-isolation-core.test.ts",
    "typecheck:tenant-isolation-core": "tsc -p scripts/tsconfig.tenant-isolation-core.json",
    "test:tenant-isolation-storage-background": "tsx --test scripts/tenant-isolation-storage-background.test.ts",
    "typecheck:tenant-isolation-storage-background": "tsc -p scripts/tsconfig.tenant-isolation-storage-background.json",
    "test:local-tenant-realtime": "node --import tsx scripts/local-tenant-realtime-smoke.mjs",
    "test:canonical-conversation": "tsx --test scripts/canonical-conversation.test.ts",
    "typecheck:canonical-conversation": "tsc -p scripts/tsconfig.canonical-conversation.json",
    "test:canonical-conversation-atomic": "tsx --test scripts/canonical-conversation-atomic.test.ts",
    "typecheck:canonical-conversation-atomic": "tsc -p scripts/tsconfig.canonical-conversation-atomic.json"
  },
  "dependencies": {
    "@luminatick/shared": "*",
    "hono": "^4.13.7",
    "jose": "^6.2.2",
    "otpauth": "^9.5.0",
    "postal-mime": "^2.1.0",
    "re2js": "^2.8.6",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240101.0",
    "@faker-js/faker": "^10.4.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.5",
    "better-sqlite3": "^12.9.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.2",
    "vitest": "^4.1.11"
  }
}
