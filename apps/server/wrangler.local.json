{
  "name": "tocyn-server-local",
  "main": "src/index.ts",
  "compatibility_date": "2024-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tocyn-local",
      "migrations_dir": "migrations",
      "remote": false
    }
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS_BUCKET",
      "bucket_name": "tocyn-local-attachments",
      "remote": false
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NOTIFICATION_DO",
        "class_name": "NotificationDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["NotificationDO"]
    }
  ],
  "observability": {
    "enabled": false
  }
}
