{
  "name": "tocyn-server-local",
  "main": "src/local-index.ts",
  "compatibility_date": "2024-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "BUDGET_ADMISSION_POLICY": "off",
    "ENVIRONMENT": "local",
    "PORTAL_URL": "http://localhost:5174",
    "CORS_ORIGINS": "http://localhost:5174,http://localhost:5173,http://127.0.0.1:5174,http://127.0.0.1:5173"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tocyn-local",
      "migrations_dir": "migrations",
      "remote": false
    }
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS_BUCKET",
      "bucket_name": "tocyn-local-attachments",
      "remote": false
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NOTIFICATION_DO",
        "class_name": "NotificationDO"
      },
      {
        "name": "BUDGET_COORDINATOR_DO",
        "class_name": "BudgetCoordinatorDO"
      },
      {
        "name": "BUDGET_GRANT_HOLDER_DO",
        "class_name": "BudgetGrantHolderDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["NotificationDO"]
    },
    {
      "tag": "v2-budget-coordinator",
      "new_sqlite_classes": ["BudgetCoordinatorDO"]
    },
    {
      "tag": "v3-budget-grant-holder",
      "new_sqlite_classes": ["BudgetGrantHolderDO"]
    }
  ],
  "observability": {
    "enabled": false,
    "redact_query_string": true,
    "logs": {
      "enabled": false,
      "invocation_logs": false,
      "persist": false,
      "destinations": []
    },
    "traces": {
      "enabled": false,
      "persist": false,
      "destinations": []
    }
  }
}
