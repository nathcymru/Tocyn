{
  "name": "@luminatick/dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run panda:generate --workspace=@luminatick/ui",
    "dev": "vite --config vite.config.ts --host 127.0.0.1 --port 5173",
    "prebuild": "npm run panda:generate --workspace=@luminatick/ui",
    "build": "tsc && vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@luminatick/shared": "*",
    "@luminatick/ui": "*",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.0.0",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "clsx": "^2.1.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "7.18.3",
    "rehype-prism-plus": "2.0.2",
    "rehype-sanitize": "^6.0.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.18",
    "jsdom": "^29.0.2",
    "postcss": "^8.4.35",
    "terser": "5.51.2",
    "typescript": "^5.0.0",
    "vite": "^8.0.8",
    "vitest": "^4.1.11"
  }
